{
  "info": {
    "name": "QuizLadder Module 1 - Question Sets",
    "description": "Full CRUD for question sets. Run after npm run db:seed with the API on port 3001. Faculty is FAC-0042. Student Ben is 2023-00456.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
    { "key": "faculty", "value": "FAC-0042" },
    { "key": "ben", "value": "2023-00456" },
    { "key": "setId", "value": "" },
    { "key": "librarySetId", "value": "" },
    { "key": "setName", "value": "" }
  ],
  "item": [
    {
      "name": "List sets and remember Library Basics",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Demo-User", "value": "{{faculty}}" }],
        "url": "{{baseUrl}}/question-sets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "const sets = pm.response.json();",
            "pm.test('body is an array', function () { pm.expect(sets).to.be.an('array'); });",
            "const library = sets.find((set) => set.name === 'Library Basics');",
            "pm.test('Library Basics is listed', function () { pm.expect(library).to.be.an('object'); });",
            "if (library) pm.collectionVariables.set('librarySetId', String(library.id));"
          ]
        }
      }]
    },
    {
      "name": "Create works",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User", "value": "{{faculty}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Week 11 Set {{$timestamp}}\"\n}"
        },
        "url": "{{baseUrl}}/question-sets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
            "const body = pm.response.json();",
            "pm.test('returns the new set', function () {",
            "  pm.expect(body.id).to.be.a('number');",
            "  pm.expect(body.name).to.be.a('string');",
            "  pm.expect(body).to.not.have.property('host_id');",
            "});",
            "pm.collectionVariables.set('setId', String(body.id));",
            "pm.collectionVariables.set('setName', body.name);"
          ]
        }
      }]
    },
    {
      "name": "Extra field host_id ignored",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User", "value": "{{faculty}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ignored Host {{$timestamp}}\",\n  \"host_id\": 99\n}"
        },
        "url": "{{baseUrl}}/question-sets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
            "const body = pm.response.json();",
            "pm.test('host_id is not stored', function () { pm.expect(body).to.not.have.property('host_id'); });",
            "pm.collectionVariables.set('extraSetId', String(body.id));"
          ]
        }
      }]
    },
    {
      "name": "Bad field short name",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User", "value": "{{faculty}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"ab\"\n}" },
        "url": "{{baseUrl}}/question-sets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
            "pm.test('VALIDATION_FAILED', function () { pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED'); });"
          ]
        }
      }]
    },
    {
      "name": "Broken JSON",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User", "value": "{{faculty}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{ \"name\": \"Quiz\"" },
        "url": "{{baseUrl}}/question-sets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
            "pm.test('INVALID_JSON', function () { pm.expect(pm.response.json().error.code).to.eql('INVALID_JSON'); });"
          ]
        }
      }]
    },
    {
      "name": "Nobody no header",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nobody Set\"\n}" },
        "url": "{{baseUrl}}/question-sets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 401', function () { pm.response.to.have.status(401); });",
            "pm.test('AUTH_REQUIRED', function () { pm.expect(pm.response.json().error.code).to.eql('AUTH_REQUIRED'); });"
          ]
        }
      }]
    },
    {
      "name": "Wrong role student",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User", "value": "{{ben}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Student Set\"\n}" },
        "url": "{{baseUrl}}/question-sets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 403', function () { pm.response.to.have.status(403); });",
            "pm.test('FORBIDDEN', function () { pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'); });"
          ]
        }
      }]
    },
    {
      "name": "Duplicate name",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User", "value": "{{faculty}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Library Basics\"\n}" },
        "url": "{{baseUrl}}/question-sets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 409', function () { pm.response.to.have.status(409); });",
            "pm.test('NAME_TAKEN', function () { pm.expect(pm.response.json().error.code).to.eql('NAME_TAKEN'); });"
          ]
        }
      }]
    },
    {
      "name": "Read one",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Demo-User", "value": "{{faculty}}" }],
        "url": "{{baseUrl}}/question-sets/{{setId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "pm.test('same set', function () {",
            "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('setId')));",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Read missing",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Demo-User", "value": "{{faculty}}" }],
        "url": "{{baseUrl}}/question-sets/999999"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
            "pm.test('QUESTION_SET_NOT_FOUND', function () { pm.expect(pm.response.json().error.code).to.eql('QUESTION_SET_NOT_FOUND'); });"
          ]
        }
      }]
    },
    {
      "name": "Bad id",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Demo-User", "value": "{{faculty}}" }],
        "url": "{{baseUrl}}/question-sets/abc"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
            "pm.test('VALIDATION_FAILED', function () { pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED'); });"
          ]
        }
      }]
    },
    {
      "name": "Update",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "X-Demo-User", "value": "{{faculty}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{setName}} renamed\"\n}" },
        "url": "{{baseUrl}}/question-sets/{{setId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "pm.test('name changed', function () {",
            "  pm.expect(pm.response.json().name).to.eql(pm.collectionVariables.get('setName') + ' renamed');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Delete used set Library Basics",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "X-Demo-User", "value": "{{faculty}}" }],
        "url": "{{baseUrl}}/question-sets/{{librarySetId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 409', function () { pm.response.to.have.status(409); });",
            "pm.test('QUESTION_SET_IN_USE', function () { pm.expect(pm.response.json().error.code).to.eql('QUESTION_SET_IN_USE'); });"
          ]
        }
      }]
    },
    {
      "name": "Delete own unused set",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "X-Demo-User", "value": "{{faculty}}" }],
        "url": "{{baseUrl}}/question-sets/{{setId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 204', function () { pm.response.to.have.status(204); });",
            "pm.test('empty body', function () { pm.expect(pm.response.text()).to.eql(''); });"
          ]
        }
      }]
    },
    {
      "name": "Delete again",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "X-Demo-User", "value": "{{faculty}}" }],
        "url": "{{baseUrl}}/question-sets/{{setId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
            "pm.test('QUESTION_SET_NOT_FOUND', function () { pm.expect(pm.response.json().error.code).to.eql('QUESTION_SET_NOT_FOUND'); });"
          ]
        }
      }]
    },
    {
      "name": "Delete the extra set",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "X-Demo-User", "value": "{{faculty}}" }],
        "url": "{{baseUrl}}/question-sets/{{extraSetId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
          ]
        }
      }]
    },
    {
      "name": "List as faculty",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Demo-User", "value": "{{faculty}}" }],
        "url": "{{baseUrl}}/question-sets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "pm.test('body is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
          ]
        }
      }]
    }
  ]
}
