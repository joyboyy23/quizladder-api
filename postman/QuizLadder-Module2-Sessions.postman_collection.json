{
  "info": {
    "name": "QuizLadder Module 2 - Sessions and Players",
    "description": "Create sessions, join/rejoin players, one game at a time, start/finish. Run after npm run db:seed with the API on port 3001. Faculty FAC-0042 creates games. Ben 2023-00456 joins clean. Ana 2023-00123 is in PLAYING 735104. librarySetId defaults to 1 (Library Basics). Do not send Content-Type: application/json on GET requests — an empty JSON body triggers INVALID_JSON before validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
    { "key": "faculty", "value": "FAC-0042" },
    { "key": "ben", "value": "2023-00456" },
    { "key": "carla", "value": "2023-00789" },
    { "key": "dino", "value": "2024-00111" },
    { "key": "eli", "value": "2024-00222" },
    { "key": "ana", "value": "2023-00123" },
    { "key": "librarySetId", "value": "1" },
    { "key": "code", "value": "" },
    { "key": "playerId", "value": "" },
    { "key": "fullCode", "value": "" }
  ],
  "item": [
    {
      "name": "Remember Library Basics set id",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Demo-User", "value": "{{faculty}}" }],
        "body": { "mode": "none" },
        "url": "{{baseUrl}}/question-sets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "const sets = pm.response.json();",
            "const library = sets.find((set) => set.name === 'Library Basics');",
            "pm.test('Library Basics is listed', function () { pm.expect(library).to.be.an('object'); });",
            "if (library) pm.collectionVariables.set('librarySetId', String(library.id));"
          ]
        }
      }]
    },
    {
      "name": "Create game",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User", "value": "{{faculty}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question_set_id\": {{librarySetId}}\n}"
        },
        "url": "{{baseUrl}}/sessions"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
            "const body = pm.response.json();",
            "pm.test('six-digit code and WAITING', function () {",
            "  pm.expect(body.code).to.match(/^[1-9][0-9]{5}$/);",
            "  pm.expect(body.status).to.eql('WAITING');",
            "  pm.expect(body).to.not.have.property('session_id');",
            "});",
            "pm.collectionVariables.set('code', body.code);"
          ]
        }
      }]
    },
    {
      "name": "Client cannot pick the code",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User", "value": "{{faculty}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question_set_id\": {{librarySetId}},\n  \"join_code\": \"111111\"\n}"
        },
        "url": "{{baseUrl}}/sessions"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
            "const body = pm.response.json();",
            "pm.test('server chose the code', function () {",
            "  pm.expect(body.code).to.match(/^[1-9][0-9]{5}$/);",
            "  pm.expect(body.code).to.not.eql('111111');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Create, bad set",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Demo-User", "value": "{{faculty}}" },
