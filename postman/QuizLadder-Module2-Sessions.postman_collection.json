          "raw": "{\n  \"status\": \"PLAYING\"\n}"
        },
        "url": "{{baseUrl}}/sessions/{{code}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "const body = pm.response.json();",
            "pm.test('started', function () {",
            "  pm.expect(body.status).to.eql('PLAYING');",
            "  pm.expect(body.started_at).to.not.eql(null);",
            "});"
          ]
        }
      }]
    },
