            "pm.test('new seat', function () {",
            "  pm.expect(body.rejoined).to.eql(false);",
            "  pm.expect(body.nickname).to.eql('BookwormBen');",
            "  pm.expect(body.avatar_color).to.eql('BLUE');",
            "  pm.expect(body.position).to.eql(1);",
            "  pm.expect(body.session.status).to.eql('WAITING');",
            "});",
            "pm.collectionVariables.set('playerId', String(body.player_id));"
