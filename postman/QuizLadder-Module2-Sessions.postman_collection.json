            "pm.test('returns the lobby', function () {",
            "  pm.expect(body.code).to.eql(pm.collectionVariables.get('code'));",
            "  pm.expect(body.status).to.eql('WAITING');",
            "  pm.expect(body).to.not.have.property('session_id');",
            "});"
          ]
        }
      }]
    },
